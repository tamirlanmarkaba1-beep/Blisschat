rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Avatars: anyone signed in can view; images up to 2 MB.
    // (In real OTP mode you can tighten the write rule to: request.auth.uid == uid)
    match /avatars/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
